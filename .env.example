# ---- DJANGO ----
DJANGO_SECRET_KEY=change-me-generate-a-new-key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---- DATABASE (MariaDB) ----
DB_NAME=bug_tracker_db
DB_USER=root
DB_PASSWORD=your-db-password
DB_HOST=127.0.0.1
DB_PORT=3306

# ---- AUTH / JWT COOKIES ----
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
AUTH_COOKIE_NAME=zbt_access
REFRESH_COOKIE_NAME=zbt_refresh
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=Lax

# ---- CORS / CSRF ----
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# ---- ATTACHMENTS ----
ATTACHMENT_MAX_SIZE_MB=10

# ---- MAIL INTAKE (IMAP) ----
# Feature toggle. With this false the rest of the application is unaffected.
MAIL_INTAKE_ENABLED=false
MAIL_INTAKE_PROVIDER=gmail
MAIL_INTAKE_EMAIL=bperp23@gmail.com
MAIL_INTAKE_IMAP_HOST=imap.gmail.com
MAIL_INTAKE_IMAP_PORT=993
MAIL_INTAKE_USE_SSL=true
MAIL_INTAKE_USERNAME=bperp23@gmail.com
# Google App Password (16 chars, no spaces) -- NEVER the real account password,
# and never committed. Generate at https://myaccount.google.com/apppasswords
MAIL_INTAKE_APP_PASSWORD=your-google-app-password
MAIL_INTAKE_FOLDER=Support
# Comma-separated. Empty means accept mail sent to any recipient.
MAIL_INTAKE_ALLOWED_RECIPIENTS=
MAIL_INTAKE_MAX_SIZE_MB=25
MAIL_INTAKE_MAX_ATTEMPTS=3
MAIL_INTAKE_BATCH_LIMIT=50
MAIL_INTAKE_SYSTEM_USERNAME=mail.intake

# ---- OUTBOUND MAIL (SMTP) ----
# Dev/test default prints mail to the console. Production must use:
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=bperp23@gmail.com
TICKET_ACK_ENABLED=true
# Set this to the requesters' reachable frontend origin in production.
PUBLIC_APP_URL=http://localhost:5173

# ---- CLASSIFICATION ----
CLASSIFY_AUTO_MIN_SCORE=80
CLASSIFY_REVIEW_MIN_SCORE=50
ACCESS_AUTO_CLASSIFY_MIN_SCORE=90
FUZZY_MATCH_MIN_SCORE=88
CLASSIFY_CONFLICT_MARGIN=15
CLASSIFY_SCORE_DECAY=0.5
CLASSIFY_BODY_FIELD_WEIGHT=0.6
CLASSIFY_BODY_CHAR_LIMIT=4000
CLASSIFY_MIN_FUZZY_PATTERN_LENGTH=5
MODULE_MAPPING_MIN_SCORE=60
MODULE_MAPPING_TIE_MARGIN=10
MAIL_DEFAULT_PRIORITY_CODE=MEDIUM
MAIL_DEFAULT_SEVERITY_CODE=MAJOR
# Phase 2 only: swap for an AI provider without touching intake or workflow code.
# CLASSIFICATION_PROVIDER=apps.classification.services.rule_classifier.RuleClassifier

# ---- CELERY / REDIS ----
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CHANNEL_REDIS_URL=redis://127.0.0.1:6379/2
CACHE_REDIS_URL=redis://127.0.0.1:6379/1
PUBLIC_TRACK_CHAT_THROTTLE_RATE=30/min
CELERY_RESULT_BACKEND=
CELERY_TASK_ACKS_LATE=true
MAIL_INTAKE_POLL_SECONDS=30
CELERY_TASK_TIME_LIMIT=240
CELERY_TASK_SOFT_TIME_LIMIT=210
