# Install under nginx's http context after replacing YOUR_DOMAIN and cert paths.
# Per-IP ceiling complements the per-IP-and-username application throttle.
# Tune on staging if many staff share one office NAT address.
limit_req_zone $binary_remote_addr zone=zigtrackr_login:10m rate=120r/m;
limit_req_status 429;

map $http_upgrade $zigtrackr_connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 80;
    server_name YOUR_DOMAIN;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name YOUR_DOMAIN;
    ssl_certificate /etc/letsencrypt/live/YOUR_DOMAIN/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/YOUR_DOMAIN/privkey.pem;
    root /home/administrator/Bug-Tracker/Frontend/dist;
    index index.html;
    client_max_body_size 30m;

    location = /api/v1/auth/login/ {
        limit_req zone=zigtrackr_login burst=100 nodelay;
        proxy_pass http://127.0.0.1:8021;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:8021;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $zigtrackr_connection_upgrade;
        proxy_read_timeout 300s;
    }

    location /static/ {
        proxy_pass http://127.0.0.1:8021;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Attachments must go through the Django permission-checked download URL.
    location /media/ { return 404; }
    location / { try_files $uri $uri/ /index.html; }
}
